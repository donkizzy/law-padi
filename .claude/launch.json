{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "frontend-5173",
      "runtimeExecutable": "bunx",
      "runtimeArgs": [
        "vite",
        "frontend",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "frontend-5181",
      "runtimeExecutable": "bunx",
      "runtimeArgs": [
        "vite",
        "frontend",
        "--port",
        "5181",
        "--strictPort"
      ],
      "port": 5181,
      "autoPort": false
    },
    {
      "name": "api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "FRONTEND_HOST=http://localhost:5181",
        "RATE_LIMIT_ENABLED=false",
        "uv",
        "run",
        "--directory",
        "backend",
        "fastapi",
        "dev",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "api-8001",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "FRONTEND_HOST=http://localhost:5182",
        "RATE_LIMIT_ENABLED=false",
        "uv",
        "run",
        "--directory",
        "backend",
        "fastapi",
        "dev",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "frontend-5182",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_URL=http://localhost:8001",
        "bunx",
        "vite",
        "frontend",
        "--port",
        "5182",
        "--strictPort"
      ],
      "port": 5182,
      "autoPort": false
    }
  ]
}
