# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Full Stack FastAPI Project"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis
# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql+psycopg://postgres:changethis@localhost:5432/app

# INGESTION_STORAGE_BACKEND=r2
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
FRONTEND_HOST=http://localhost:8000

INGESTION_STORAGE_BACKEND=local
# Act ingestion is opt-in; source and extraction approval still apply.
INGESTION_ALLOWED_INSTRUMENT_TYPES=["constitution"]
INGESTION_STORAGE_DIR=storage/source-documents
MALWARE_SCANNER_BACKEND=static_pdf
RETRIEVAL_INDEX_BACKEND=pgvector
RETRIEVAL_VECTOR_DIMENSIONS=1024
MANAGED_OCR_PROVIDER=disabled
# pick ONE:
# OPENAI_API_KEY=sk-proj-...
# OR:
HUGGINGFACE_TEI_ENDPOINT_URL=https://router.huggingface.co/hf-inference/models/BAAI/bge-m3/pipeline/feature-extraction
HUGGINGFACE_API_TOKEN=

# Evidence-backed chat. Keep public generation off until the evaluation and
# provider-capacity gates in docs/evidence-chat-rollout.md are satisfied.
CHAT_ENABLED=false
CHAT_GENERATION_ENABLED=false
CHAT_GENERATION_KILL_SWITCH=false
CHAT_MAX_ACTIVE_GENERATIONS=100
CHAT_DAILY_BUDGET_USD=100
# Set the real key only in the ignored repository-root .env or deployment secret.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
# Answer languages (English is always on). Non-English answers are translated
# from the verified English answer and labelled beta until native review.
# CHAT_LANGUAGES_ENABLED=["en","pcm","yo","ha","ig"]
