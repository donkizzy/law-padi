exports[`edge output is pinned renders /welcome unchanged 1`] = `
{
  "html": "<!DOCTYPE html><html lang="en"><head><title data-public-head>Nigeria&#39;s Constitution and published laws | constitution.ng</title><meta data-public-head name="description" content="Explore Nigeria&#39;s Constitution and published laws with precise citations, source-edition notices and original documents. Free and independent."><meta data-public-head name="robots" content="index, follow"><meta data-public-head property="og:type" content="website"><meta data-public-head property="og:site_name" content="constitution.ng"><meta data-public-head property="og:title" content="Nigeria&#39;s Constitution and published laws | constitution.ng"><meta data-public-head property="og:description" content="Explore Nigeria&#39;s Constitution and published laws with precise citations, source-edition notices and original documents. Free and independent."><link data-public-head rel="canonical" href="https://example.test/welcome"><meta data-public-head property="og:url" content="https://example.test/welcome"><meta data-public-head name="twitter:card" content="summary"><script data-public-head type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is this legal advice?","acceptedAnswer":{"@type":"Answer","text":"No. constitution.ng explains published Nigerian legal sources and shows you the exact section. If you are facing a court case, an arrest or a dispute, speak to a lawyer or the Legal Aid Council. Bring the sections you found here with you."}},{"@type":"Question","name":"Is it free?","acceptedAnswer":{"@type":"Answer","text":"Yes. Asking questions, finding sections and reading the published source edition are free. There is no paid plan."}},{"@type":"Question","name":"Do I need an account?","acceptedAnswer":{"@type":"Answer","text":"No. You can ask and read as a guest. Create an account only if you want your conversations to follow you to another device."}},{"@type":"Question","name":"Is this the current Constitution?","acceptedAnswer":{"@type":"Answer","text":"It is the 1999 Constitution as published in 2004. Amendments passed after that are not included yet, so a section may have changed since. Every answer tells you this so you can check before you rely on it."}},{"@type":"Question","name":"Which laws can I read?","acceptedAnswer":{"@type":"Answer","text":"The law picker lists the laws in the selected published release. A law under review is not available there. Each provision identifies its source edition. Acts labelled as enacted may have been amended; check the original source and later changes before relying on them."}},{"@type":"Question","name":"Can I ask in Pidgin?","acceptedAnswer":{"@type":"Answer","text":"Yes. Ask the way you would say it, in English or Pidgin, and we will find the section. You can also switch the site to Pidgin, Yorùbá, Hausa or Igbo. The official wording is always the English text."}},{"@type":"Question","name":"How do you choose the section?","acceptedAnswer":{"@type":"Answer","text":"Your question is matched against published sections, using both the words you typed and what you mean. Citations come from the text itself, never guessed, and every answer lists the sections it used so you can read them yourself."}},{"@type":"Question","name":"Can I quote an answer?","acceptedAnswer":{"@type":"Answer","text":"Yes. Copy any answer with its citations, or save the sections you need. Quote the official wording, not the explanation, when accuracy matters."}},{"@type":"Question","name":"Is this a government website?","acceptedAnswer":{"@type":"Answer","text":"No. constitution.ng is independent. It is not published by, or connected to, the National Assembly or any government body."}}]}</script><script data-public-head type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","@id":"https://example.test/#website","url":"https://example.test/welcome","name":"constitution.ng","description":"Explore Nigeria's Constitution and published laws with precise citations, source-edition notices and original documents. Free and independent.","inLanguage":"en","publisher":{"@type":"Organization","@id":"https://example.test/#publisher","name":"constitution.ng","url":"https://example.test/about"}}</script><script data-public-head type="application/ld+json">{"@context":"https://schema.org","@type":"WebPage","@id":"https://example.test/welcome","url":"https://example.test/welcome","name":"Nigeria's Constitution and published laws | constitution.ng","description":"Explore Nigeria's Constitution and published laws with precise citations, source-edition notices and original documents. Free and independent.","inLanguage":"en","isPartOf":{"@id":"https://example.test/#website"}}</script></head><body><div id="root"><main class="mx-auto max-w-4xl px-4 py-8 sm:px-8"><nav aria-label="Public navigation" class="flex flex-wrap gap-4 text-sm"><a class="text-primary underline" href="/welcome">constitution.ng</a> <a class="text-primary underline" href="/laws">Browse published laws</a> <a class="text-primary underline" href="/about">Sources and corrections</a></nav><h1 class="mt-8 font-display text-title-1">Ask about your rights. Get the exact section.</h1><p class="mt-4 text-body-lg leading-7">Explore Nigeria&#39;s Constitution and published laws with precise citations, source-edition notices and original documents. Free and independent.</p><p class="mt-4 text-body-lg leading-7">This is the 1999 Constitution as published in 2004. Later amendments aren&#39;t included yet, so a section may have changed since.</p><form action="/" method="get" class="mt-8"><label for="public-question">Your question about published laws</label><input id="public-question" name="q" required maxlength="2000" class="sq-md mt-4 block w-full border border-border bg-card p-4"><input type="hidden" name="intent" value="find"><button class="sq-sm mt-4 bg-primary px-4 py-2 text-primary-foreground" type="submit">Find a section</button></form><h2 class="mt-8 font-display text-title-3">Read the original wording</h2><ul class="mt-4 grid gap-3"><li><a class="text-primary underline" href="/constitution/constitution-1999.chapter4.section37">Section 37: Right to private and family life</a></li><li><a class="text-primary underline" href="/constitution/constitution-1999.chapter4.section35">Section 35: Right to personal liberty</a></li><li><a class="text-primary underline" href="/laws">Browse published laws, sections and schedules</a></li></ul><h2 class="mt-8 font-display text-title-3">Check every answer against its source</h2><p class="mt-4 text-body-lg leading-7">Questions can be phrased in English or Pidgin; explanations are in English. Read the cited source wording and its edition before relying on an explanation. The source edition has known gaps and does not include later amendments.</p><p class="mt-4 text-body-lg leading-7"><a class="text-primary underline" href="/methodology">Read the dated retrieval test and its limits</a> and <a class="text-primary underline" href="/about">how sources, review and corrections work</a>.</p><h2 class="mt-8 font-display text-title-3">Before you ask</h2><details class="mt-4"><summary>Is this legal advice?</summary><p class="mt-4 text-body-lg leading-7">No. constitution.ng explains published Nigerian legal sources and shows you the exact section. If you are facing a court case, an arrest or a dispute, speak to a lawyer or the Legal Aid Council. Bring the sections you found here with you.</p></details><details class="mt-4"><summary>Is it free?</summary><p class="mt-4 text-body-lg leading-7">Yes. Asking questions, finding sections and reading the published source edition are free. There is no paid plan.</p></details><details class="mt-4"><summary>Do I need an account?</summary><p class="mt-4 text-body-lg leading-7">No. You can ask and read as a guest. Create an account only if you want your conversations to follow you to another device.</p></details><details class="mt-4"><summary>Is this the current Constitution?</summary><p class="mt-4 text-body-lg leading-7">It is the 1999 Constitution as published in 2004. Amendments passed after that are not included yet, so a section may have changed since. Every answer tells you this so you can check before you rely on it.</p></details><details class="mt-4"><summary>Which laws can I read?</summary><p class="mt-4 text-body-lg leading-7">The law picker lists the laws in the selected published release. A law under review is not available there. Each provision identifies its source edition. Acts labelled as enacted may have been amended; check the original source and later changes before relying on them.</p></details><details class="mt-4"><summary>Can I ask in Pidgin?</summary><p class="mt-4 text-body-lg leading-7">Yes. Ask the way you would say it, in English or Pidgin, and we will find the section. You can also switch the site to Pidgin, Yorùbá, Hausa or Igbo. The official wording is always the English text.</p></details><details class="mt-4"><summary>How do you choose the section?</summary><p class="mt-4 text-body-lg leading-7">Your question is matched against published sections, using both the words you typed and what you mean. Citations come from the text itself, never guessed, and every answer lists the sections it used so you can read them yourself.</p></details><details class="mt-4"><summary>Can I quote an answer?</summary><p class="mt-4 text-body-lg leading-7">Yes. Copy any answer with its citations, or save the sections you need. Quote the official wording, not the explanation, when accuracy matters.</p></details><details class="mt-4"><summary>Is this a government website?</summary><p class="mt-4 text-body-lg leading-7">No. constitution.ng is independent. It is not published by, or connected to, the National Assembly or any government body.</p></details><footer class="mt-8 border-t border-border py-8 text-sm"><a class="text-primary underline" href="/about">About constitution.ng</a> · <a class="text-primary underline" href="/methodology">Retrieval methodology</a> · <a class="text-primary underline" href="mailto:hello@amosgodwin.com?subject=Correction">Report a correction</a><p class="mt-4">Independent. Not a government publication. Explanations are not legal advice.</p></footer></main></div><script src="/assets/index-Abcdef12.js"></script></body></html>",
  "link": "<https://example.test/welcome>; rel="canonical"",
  "location": null,
  "robots": "index, follow",
  "status": 200,
}
`;

exports[`edge output is pinned renders /about unchanged 1`] = `
{
  "html": "<!DOCTYPE html><html lang="en"><head><title data-public-head>About, sources and corrections | constitution.ng</title><meta data-public-head name="description" content="Who publishes constitution.ng, which source editions it uses, how sources and explanations are checked, and how to report a correction."><meta data-public-head name="robots" content="index, follow"><meta data-public-head property="og:type" content="website"><meta data-public-head property="og:site_name" content="constitution.ng"><meta data-public-head property="og:title" content="About, sources and corrections | constitution.ng"><meta data-public-head property="og:description" content="Who publishes constitution.ng, which source editions it uses, how sources and explanations are checked, and how to report a correction."><link data-public-head rel="canonical" href="https://example.test/about"><meta data-public-head property="og:url" content="https://example.test/about"><meta data-public-head name="twitter:card" content="summary"><script data-public-head type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","@id":"https://example.test/#website","url":"https://example.test/welcome","name":"constitution.ng","description":"Explore Nigeria's Constitution and published laws with precise citations, source-edition notices and original documents. Free and independent.","inLanguage":"en","publisher":{"@type":"Organization","@id":"https://example.test/#publisher","name":"constitution.ng","url":"https://example.test/about"}}</script><script data-public-head type="application/ld+json">{"@context":"https://schema.org","@type":"WebPage","@id":"https://example.test/about","url":"https://example.test/about","name":"About, sources and corrections | constitution.ng","description":"Who publishes constitution.ng, which source editions it uses, how sources and explanations are checked, and how to report a correction.","inLanguage":"en","isPartOf":{"@id":"https://example.test/#website"}}</script></head><body><div id="root"><main class="mx-auto max-w-4xl px-4 py-8 sm:px-8"><nav aria-label="Public navigation" class="flex flex-wrap gap-4 text-sm"><a class="text-primary underline" href="/welcome">constitution.ng</a> <a class="text-primary underline" href="/laws">Browse published laws</a> <a class="text-primary underline" href="/about">Sources and corrections</a></nav><h1 class="mt-8 font-display text-title-2">About constitution.ng</h1><section><h2 class="mt-8 font-display text-title-3">An independent legal reference</h2><p class="mt-4 text-body-lg leading-7">constitution.ng publishes a searchable source editions of Nigeria&#39;s Constitution and published laws, and a tool for finding and explaining provisions. The publisher is constitution.ng. This is an independent project, not a government publication or a service affiliated with the National Assembly. Explanations are information, not legal advice.</p></section><section><h2 class="mt-8 font-display text-title-3">Source edition and scope</h2><p class="mt-4 text-body-lg leading-7">This is the 1999 Constitution as published in 2004. Later amendments aren&#39;t included yet, so a section may have changed since. Only laws in the selected published release appear in the law picker. Acts are shown as enacted and may have been amended. The reading pages identify the exact release and link to the source document and printed page. The Constitution source contains known gaps, including a missing Section 168 and two Section 189 identities distinguished by their source locations. Do not assume this is a complete or current consolidated edition.</p></section><section><h2 class="mt-8 font-display text-title-3">How wording and explanations are handled</h2><p class="mt-4 text-body-lg leading-7">The reading pages show published source wording separately from generated explanations. Citations come from structured provision identities. Explanations use retrieved evidence and automated checks, but can still miss context or details. This site does not certify every explanation as reviewed by a lawyer. Check the cited wording and source, and consult a qualified lawyer for a legal decision.</p></section><section><h2 class="mt-8 font-display text-title-3">Updates and corrections</h2><p class="mt-4 text-body-lg leading-7">A release identifies the edition being read; a new website build does not mean the law has changed. To report a mistake, email us at hello@amosgodwin.com. You don&#39;t need an account. Include the provision link, release and printed page if you have them. Don&#39;t send private case details or confidential documents.</p></section><p class="mt-4 text-body-lg leading-7"><a class="text-primary underline" href="/methodology/benchmark.json">Versioned retrieval test</a></p><footer class="mt-8 border-t border-border py-8 text-sm"><a class="text-primary underline" href="/about">About constitution.ng</a> · <a class="text-primary underline" href="/methodology">Retrieval methodology</a> · <a class="text-primary underline" href="mailto:hello@amosgodwin.com?subject=Correction">Report a correction</a><p class="mt-4">Independent. Not a government publication. Explanations are not legal advice.</p></footer></main></div><script src="/assets/index-Abcdef12.js"></script></body></html>",
  "link": "<https://example.test/about>; rel="canonical"",
  "location": null,
  "robots": "index, follow",
  "status": 200,
}
`;

exports[`edge output is pinned renders /methodology unchanged 1`] = `
{
  "html": "<!DOCTYPE html><html lang="en"><head><title data-public-head>Retrieval test and methodology | constitution.ng</title><meta data-public-head name="description" content="Read the scope and limits of constitution.ng&#39;s dated plain-language retrieval benchmark, including the test set and source edition."><meta data-public-head name="robots" content="index, follow"><meta data-public-head property="og:type" content="website"><meta data-public-head property="og:site_name" content="constitution.ng"><meta data-public-head property="og:title" content="Retrieval test and methodology | constitution.ng"><meta data-public-head property="og:description" content="Read the scope and limits of constitution.ng&#39;s dated plain-language retrieval benchmark, including the test set and source edition."><link data-public-head rel="canonical" href="https://example.test/methodology"><meta data-public-head property="og:url" content="https://example.test/methodology"><meta data-public-head name="twitter:card" content="summary"><script data-public-head type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","@id":"https://example.test/#website","url":"https://example.test/welcome","name":"constitution.ng","description":"Explore Nigeria's Constitution and published laws with precise citations, source-edition notices and original documents. Free and independent.","inLanguage":"en","publisher":{"@type":"Organization","@id":"https://example.test/#publisher","name":"constitution.ng","url":"https://example.test/about"}}</script><script data-public-head type="application/ld+json">{"@context":"https://schema.org","@type":"WebPage","@id":"https://example.test/methodology","url":"https://example.test/methodology","name":"Retrieval test and methodology | constitution.ng","description":"Read the scope and limits of constitution.ng's dated plain-language retrieval benchmark, including the test set and source edition.","inLanguage":"en","isPartOf":{"@id":"https://example.test/#website"}}</script></head><body><div id="root"><main class="mx-auto max-w-4xl px-4 py-8 sm:px-8"><nav aria-label="Public navigation" class="flex flex-wrap gap-4 text-sm"><a class="text-primary underline" href="/welcome">constitution.ng</a> <a class="text-primary underline" href="/laws">Browse published laws</a> <a class="text-primary underline" href="/about">Sources and corrections</a></nav><h1 class="mt-8 font-display text-title-2">How we check section retrieval</h1><section><h2 class="mt-8 font-display text-title-3">What was measured</h2><p class="mt-4 text-body-lg leading-7">The downloadable plain-language-retrieval-v1 benchmark contains 57 everyday English and Pidgin-style questions and expected sections. The recorded 12 October 2026 run used the original 55 cases; its result reports a 0.98 top-one hit rate and 1.0 top-five hit rate after adding the topic guide. This is a retained retrieval result, not a new test of the current deployment.</p></section><section><h2 class="mt-8 font-display text-title-3">What the result does not establish</h2><p class="mt-4 text-body-lg leading-7">A retrieval hit means an expected section appeared in the measured search position. It does not measure the correctness of generated explanations, legal advice quality, completeness of the corpus, current-law coverage or performance on questions outside the test set. The questions are a small curated set, not a representative sample of all users.</p></section><section><h2 class="mt-8 font-display text-title-3">Reproducible scope</h2><p class="mt-4 text-body-lg leading-7">The versioned test file records each question and its expected sections. A repeat test should record the deployed revision, published corpus release, retrieval configuration, date and per-question results. Compare the same dataset before reporting a change. Source wording and later amendments require separate verification.</p></section><p class="mt-4 text-body-lg leading-7"><a class="text-primary underline" href="/methodology/benchmark.json">Versioned retrieval test</a></p><footer class="mt-8 border-t border-border py-8 text-sm"><a class="text-primary underline" href="/about">About constitution.ng</a> · <a class="text-primary underline" href="/methodology">Retrieval methodology</a> · <a class="text-primary underline" href="mailto:hello@amosgodwin.com?subject=Correction">Report a correction</a><p class="mt-4">Independent. Not a government publication. Explanations are not legal advice.</p></footer></main></div><script src="/assets/index-Abcdef12.js"></script></body></html>",
  "link": "<https://example.test/methodology>; rel="canonical"",
  "location": null,
  "robots": "index, follow",
  "status": 200,
}
`;

