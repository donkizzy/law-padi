{
  "name": "constitition-ng",
  "main": "worker.ts",
  "compatibility_date": "2026-10-14",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../backend/app/frontend",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": false },
  "vars": { "API_ORIGIN": "https://constitution-ng-api.onrender.com" }
}
