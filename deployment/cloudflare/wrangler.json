{
  "name": "constitution-ng",
  "main": "worker.ts",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "assets": {
    "directory": "../../backend/app/frontend",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "limits": { "cpu_ms": 10 },
  "observability": { "enabled": false },
  "vars": { "API_ORIGIN": "https://configure-your-api-origin.run.app" }
}
