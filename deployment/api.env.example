# Copy into deployment/api.env; fill every placeholder, chmod 600, never commit.
# This is a dotenv file mounted by Secret Manager, not sourced by the shell.
PROJECT_NAME="constitution.ng"
SECRET_KEY="REPLACE_WITH_CRYPTOGRAPHIC_RANDOM_VALUE"
DATABASE_URL="postgresql://USER:PASSWORD@YOUR_DIRECT_NEON_HOST/neondb?sslmode=verify-full&sslrootcert=/app/.venv/lib/python3.14/site-packages/certifi/cacert.pem"
FIRST_SUPERUSER="YOUR_ADMIN_EMAIL"
FIRST_SUPERUSER_PASSWORD="REPLACE_WITH_RANDOM_BOOTSTRAP_PASSWORD"
ORIGIN_PROXY_SECRET="REPLACE_WITH_RANDOM_SHARED_CLOUDFLARE_ORIGIN_SECRET"
INGESTION_STORAGE_BACKEND=r2
R2_ENDPOINT_URL="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
R2_BUCKET_NAME="constitution-sources"
R2_ACCESS_KEY_ID="REPLACE_WITH_BUCKET_SCOPED_ACCESS_KEY"
R2_SECRET_ACCESS_KEY="REPLACE_WITH_BUCKET_SCOPED_SECRET"
# Add SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, EMAILS_FROM_EMAIL only
# after a free provider and its permitted sending domain have been configured.
