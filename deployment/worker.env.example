# A separate dotenv secret. API does not receive provider or backup credentials.
PROJECT_NAME="constitution.ng"
SECRET_KEY="REPLACE_WITH_SAME_APP_SIGNING_KEY"
DATABASE_URL="postgresql://USER:PASSWORD@YOUR_DIRECT_NEON_HOST/neondb?sslmode=verify-full&sslrootcert=/app/.venv/lib/python3.14/site-packages/certifi/cacert.pem"
FIRST_SUPERUSER="YOUR_ADMIN_EMAIL"
FIRST_SUPERUSER_PASSWORD="REPLACE_WITH_RANDOM_BOOTSTRAP_PASSWORD"
DEEPSEEK_API_KEY="REPLACE_WITH_PROVIDER_KEY"
# No HF token or paid embedding endpoint for the initial lexical retrieval beta.
# Private GCS writes use the Cloud Run service identity, not a static key.
