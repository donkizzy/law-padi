# Deny by default: only application/build inputs enter the Docker context.
# Keep frontend tests for Dockerfile.playwright; production copies src/public only.
**
!.dockerignore
!pyproject.toml
!uv.lock
!package.json
!bun.lock
!backend/
!backend/Dockerfile
!backend/pyproject.toml
!backend/alembic.ini
!backend/app/
!backend/app/**
!backend/scripts/
!backend/scripts/**
!frontend/
!frontend/package.json
!frontend/index.html
!frontend/vite.config.ts
!frontend/tsconfig*.json
!frontend/playwright*.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!frontend/tests/
!frontend/tests/**
!services/
!services/ingestion-worker/
!services/ingestion-worker/requirements.txt
!services/ingestion-worker/ingestion_worker/
!services/ingestion-worker/ingestion_worker/**
!deployment/
!deployment/railway/
!deployment/railway/run.sh
!deployment/cloudflare/
!deployment/cloudflare/worker.ts
!deployment/cloudflare/public-pages.ts
!deployment/cloudflare/pages.ts
!deployment/cloudflare/html.ts
!deployment/cloudflare/wrangler.json
!deployment/cloudflare/tsconfig.json
!eval/
!eval/datasets/
!eval/datasets/plain-language-retrieval-benchmark-v1.json
!scripts/
!scripts/build_revision.py

# Exclude generated content and private files even inside allowed directories.
**/.env
**/.env.*
**/*.pem
**/*.key
**/.DS_Store
**/__pycache__
**/*.py[cod]
**/.venv
**/node_modules
**/.mypy_cache
**/.pytest_cache
**/.ruff_cache
**/.coverage*
**/htmlcov
**/.tanstack
**/dist
**/blob-report
**/playwright-report
**/test-results
**/playwright/.auth
backend/app/frontend
